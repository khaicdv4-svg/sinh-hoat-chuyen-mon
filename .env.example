# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI (tuỳ chọn). Không có khoá thì các nút AI tự ẩn.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Giới hạn số lần gọi AI mỗi người mỗi ngày
AI_DAILY_LIMIT_TEACHER=30
AI_DAILY_LIMIT_LEADER=150

# Tên hiển thị trên biên bản
NEXT_PUBLIC_SCHOOL_NAME=TRƯỜNG TIỂU HỌC TRẦN VĂN ƠN
NEXT_PUBLIC_TEAM_NAME=TỔ CHUYÊN MÔN KHỐI 4
NEXT_PUBLIC_SCHOOL_YEAR=2026-2027
